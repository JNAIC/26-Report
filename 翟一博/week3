import os
import time
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, TensorDataset
from mnist_data import load_mnist
x, y, xt, yt = load_mnist("data")
train_loader = DataLoader(TensorDataset(torch.from_numpy(x), torch.from_numpy(y)),
                          batch_size=128, shuffle=True)
test_loader = DataLoader(TensorDataset(torch.from_numpy(xt), torch.from_numpy(yt)),
                         batch_size=512)
model = nn.Sequential(
    nn.Conv2d(1, 32, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2),
    nn.Conv2d(32, 64, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2),
    nn.Flatten(),
    nn.Linear(64 * 7 * 7, 128), nn.ReLU(), nn.Dropout(0.25),
    nn.Linear(128, 10),
)
print("参数量:", sum(p.numel() for p in model.parameters()))
loss_fn = nn.CrossEntropyLoss()
opt = torch.optim.Adam(model.parameters(), lr=1e-3)
t0 = time.time()
for epoch in range(1, 4):
    model.train()
    total = 0.0
    for xb, yb in train_loader:
        opt.zero_grad()
        loss = loss_fn(model(xb), yb)
        loss.backward()
        opt.step()
        total += loss.item()
    model.eval()
    correct = 0
    with torch.no_grad():
        for xb, yb in test_loader:
            correct += (model(xb).argmax(1) == yb).sum().item()
    print(f"epoch {epoch}: loss={total / len(train_loader):.4f}  "
          f"test_acc={correct / len(yt) * 100:.2f}%")
print(f"训练耗时: {time.time() - t0:.1f}s")
os.makedirs("results", exist_ok=True)
torch.save(model.state_dict(), "results/mnist_cnn.pt")
print("模型已保存: results/mnist_cnn.pt")
